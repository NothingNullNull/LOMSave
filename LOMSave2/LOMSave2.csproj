<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>LOMSave2</AssemblyName>
    <RootNamespace>LOMSave2</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="netstandard">
      <HintPath>$(GameDir)\Mortal_Data\Managed\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" Condition="'$(BepInExVersion)' == '5'">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core" Condition="'$(BepInExVersion)' == '6'">
      <HintPath>$(BepInExDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono" Condition="'$(BepInExVersion)' == '6'">
      <HintPath>$(BepInExDir)\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Core">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Story">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Story.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mortal.Free">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Free.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fungus">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Fungus.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OBB.Framework">
      <HintPath>$(GameDir)\Mortal_Data\Managed\OBB.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateBepInEx" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(BepInExVersion)' != '5' And '$(BepInExVersion)' != '6'" Text="BepInExVersion 只支持 5 或 6。" />
    <Error Condition="'$(BepInExVersion)' == '5' And !Exists('$(BepInExDir)\BepInEx.dll')" Text="BepInEx 5 构建需要 BepInEx.dll，请检查 BepInExDir。" />
    <Error Condition="'$(BepInExVersion)' == '6' And (!Exists('$(BepInExDir)\BepInEx.Core.dll') Or !Exists('$(BepInExDir)\BepInEx.Unity.Mono.dll'))" Text="BepInEx 6 构建需要 Core 和 Unity.Mono 程序集，请检查 BepInExDir。" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\LOMSave2\" />
  </Target>

</Project>
