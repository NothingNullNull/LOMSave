<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deploy>false</Deploy>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\LOMSave2\LOMSave2.csproj" AdditionalProperties="Deploy=false" />
    <Reference Include="Fungus"><HintPath>$(GameDir)\Mortal_Data\Managed\Fungus.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)\Mortal_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mortal.Core"><HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mortal.Story"><HintPath>$(GameDir)\Mortal_Data\Managed\Mortal.Story.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Mortal_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx" Condition="'$(BepInExVersion)' == '5'"><HintPath>$(BepInExDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core" Condition="'$(BepInExVersion)' == '6'"><HintPath>$(BepInExDir)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Mono" Condition="'$(BepInExVersion)' == '6'"><HintPath>$(BepInExDir)\BepInEx.Unity.Mono.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameDir)\Mortal_Data\Managed\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
